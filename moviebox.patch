+/// Catalogs worth searching: those an addon declares with a `search` extra.
+/// Cinemeta keeps its built-in `top` catalogs. Addons without a real
+/// searchable catalog are skipped instead of being sent made-up requests.
+fn search_targets(addons: &[InstalledAddon]) -> Vec<SearchTarget> {
+    let mut targets: Vec<SearchTarget> = Vec::new();
+    for addon in addons.iter().filter(|a| a.enabled && a.is_core()) {
+        let base_url = AddonClient::base_addon_url(&addon.manifest_url);
+        let mut wanted: Vec<(String, String)> = Vec::new();
+        for cat in &addon.catalogs {
+            if cat.r#type.trim().is_empty() || cat.id.trim().is_empty() {
+                continue;
+            }
+            if cat
+                .extra
+                .iter()
+                .any(|e| e.name.eq_ignore_ascii_case("search"))
+            {
+                wanted.push((cat.r#type.clone(), cat.id.clone()));
+            }
+        }
+        if wanted.is_empty() && addon.is_core() {
+            wanted.push(("movie".to_string(), "top".to_string()));
+            wanted.push(("series".to_string(), "top".to_string()));
+        }
+        for (r#type, catalog_id) in wanted {
+            let duplicate = targets.iter().any(|t| {
+                t.base_url == base_url
+                    && t.r#type.eq_ignore_ascii_case(&r#type)
+                    && t.catalog_id == catalog_id
+            });
+            if !duplicate && targets.len() < MAX_SEARCH_TARGETS {
+                targets.push(SearchTarget {
+                    addon: addon.name.clone(),
+                    base_url: base_url.clone(),
+                    r#type,
+                    catalog_id,
+                });
+            }
+        }
+    }
+    targets
