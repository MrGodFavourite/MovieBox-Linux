+/// Adds episodes from `others` that `base` does not have, and fills blank
+/// titles/overviews/thumbnails of episodes it already has.
+fn merge_meta_videos(base: &mut models::MetaDetail, others: &[models::MetaDetail]) {
+    for other in others {
+        for v in &other.videos {
+            let key = video_key(v);
+            if let Some(existing) = base.videos.iter_mut().find(|b| video_key(b) == key) {
+                if existing.title.is_none() && existing.name.is_none() {
+                    existing.title = v.title.clone();
+                    existing.name = v.name.clone();
+                }
+                if existing.overview.is_none() && existing.description.is_none() {
+                    existing.overview = v.overview.clone();
+                    existing.description = v.description.clone();
+                }
+                if existing.thumbnail.is_none() {
+                    existing.thumbnail = v.thumbnail.clone();
+                }
+                if existing.released.is_none() {
+                    existing.released = v.released.clone();
+                }
+            } else {
+                base.videos.push(v.clone());
+            }
+        }
+    }
+}
