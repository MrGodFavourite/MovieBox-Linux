+/// Modules the bundled Nuvio app provides to scrapers but plain Node lacks.
+const NUVIO_MODULES: &[&str] = &["cheerio@1.0.0", "crypto-js@4.2.0"];
+
+static MODULES_LOCK: tokio::sync::Mutex<()> = tokio::sync::Mutex::const_new(());
+
+/// Installs the scraper dependencies into `<cache>/nuvio/node_modules` once.
+/// All scrapers start in parallel, so the lock makes the first one install
+/// while the rest wait and then find the modules in place.
+async fn ensure_modules(dir: &Path) -> Result<(), String> {
+    let present = |d: &Path| {
+        d.join("node_modules/cheerio/package.json").is_file()
+            && d.join("node_modules/crypto-js/package.json").is_file()
+    };
+    if present(dir) {
+        return Ok(());
+    }
+    let _guard = MODULES_LOCK.lock().await;
+    if present(dir) {
+        return Ok(());
+    }
+    log::info!("nuvio: installing scraper dependencies (cheerio, crypto-js)");
+    let npm = std::env::var("MOVIEBOX_NPM")
+        .ok()
+        .map(|v| v.trim().to_string())
+        .filter(|v| !v.is_empty())
+        .unwrap_or_else(|| {
+            if cfg!(windows) { "npm.cmd" } else { "npm" }.to_string()
+        });
+    let mut cmd = tokio::process::Command::new(npm);
+    cmd.arg("install")
+        .arg("--prefix")
+        .arg(dir)
+        .args(["--no-audit", "--no-fund", "--loglevel=error"])
+        .args(NUVIO_MODULES)
+        .stdin(std::process::Stdio::null())
+        .stdout(std::process::Stdio::piped())
+        .stderr(std::process::Stdio::piped())
+        .kill_on_drop(true);
+    #[cfg(windows)]
+    cmd.creation_flags(crate::player::CREATE_NO_WINDOW);
+    let output = tokio::time::timeout(Duration::from_secs(180), cmd.output())
+        .await
+        .map_err(|_| "npm install timed out".to_string())?
+        .map_err(|e| {
+            if e.kind() == std::io::ErrorKind::NotFound {
+                "npm not found: run `npm install cheerio crypto-js` in the nuvio cache folder (or set MOVIEBOX_NPM)".to_string()
+            } else {
+                format!("Cannot start npm: {e}")
+            }
+        })?;
+    if !output.status.success() || !present(dir) {
+        let err = String::from_utf8_lossy(&output.stderr);
+        let tail: String = err.chars().rev().take(300).collect::<Vec<_>>().into_iter().rev().collect();
+        return Err(format!("Installing Nuvio scraper dependencies failed: {tail}"));
+    }
+    Ok(())
+}
+
+async fn run_node(
+    runner: &Path,
+    script: &Path,
+    id: &str,
+    media_type: &str,
+    season: &str,
+    episode: &str,
+) -> Result<String, String> {
+    let modules_dir = cache_dir();
+    ensure_modules(&modules_dir).await?;
+    let node = std::env::var("MOVIEBOX_NODE")
+        .ok()
+        .map(|v| v.trim().to_string())
+        .filter(|v| !v.is_empty())
+        .unwrap_or_else(|| "node".to_string());
+    let mut cmd = tokio::process::Command::new(node);
+    cmd.arg(runner)
+        .arg(script)
+        .arg(id)
+        .arg(media_type)
+        .arg(season)
+        .arg(episode)
+        .env("NUVIO_MODULES_DIR", &modules_dir)
+        .env(
+            "NUVIO_TIMEOUT_MS",
+            SCRAPER_DEADLINE
+                .as_millis()
+                .saturating_sub(3000)
+                .to_string(),
+        )
+        .stdin(std::process::Stdio::null())
+        .stdout(std::process::Stdio::piped())
+        .stderr(std::process::Stdio::piped())
+        .kill_on_drop(true);
+    #[cfg(windows)]
+    cmd.creation_flags(crate::player::CREATE_NO_WINDOW);
+    let output = cmd.output().await.map_err(|e| {
+        if e.kind() == std::io::ErrorKind::NotFound {
+            "Node.js not found. Install Node.js 18+ (or set MOVIEBOX_NODE)".to_string()
+        } else {
+            format!("Cannot start Node.js: {e}")
+        }
+    })?;
+    let stdout = String::from_utf8_lossy(&output.stdout).to_string();
+    if stdout.trim().is_empty() {
+        let stderr = String::from_utf8_lossy(&output.stderr);
+        let tail: String = stderr
+            .lines()
+            .rev()
+            .find(|l| !l.trim().is_empty())
+            .unwrap_or("no output")
+            .chars()
+            .take(160)
+            .collect();
+        return Err(format!("The scraper printed nothing ({}): {tail}", output.status));
+    }
+    Ok(stdout)
+}
