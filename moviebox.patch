+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct AddonFilterPill {
+    pub filter: Option<String>,
+    pub rect: Rect,
+}
+
+pub fn addon_filter_bar_visible(state: &AppState) -> bool {
+    state.current_subject_provider() == crate::providers::models::ProviderKind::Addons
+        && !state.addon_filter_tabs().is_empty()
+}
+
+pub fn layout_addon_filter_pills(
+    state: &AppState,
+    bar_area: Rect,
+    theme: &Theme,
+    modal_active: bool,
+) -> (Vec<AddonFilterPill>, Line<'static>) {
+    use crate::providers::addons::AddonStreamState;
+
+    if bar_area.width == 0 || bar_area.height == 0 {
+        return (Vec::new(), Line::default());
+    }
+
+    let tabs = state.addon_filter_tabs();
+    if tabs.is_empty() {
+        return (Vec::new(), Line::default());
+    }
+
+    struct RawPill {
+        filter: Option<String>,
+        label: String,
+        is_active: bool,
+        style: Style,
+    }
+
+    let mut raw_pills = Vec::with_capacity(tabs.len() + 1);
+    let all_active = state.addon_stream_filter.is_none();
+    let all_label = format!(" All ({}) ", state.selected_resources.len());
+    let active_bg = theme.accent.fg.unwrap_or(Color::Cyan);
+    let active_style = if modal_active {
+        theme.muted
+    } else if state.basic_terminal {
+        theme.accent.add_modifier(Modifier::BOLD | Modifier::REVERSED)
+    } else {
+        Style::default()
+            .fg(theme.base)
+            .bg(active_bg)
+            .add_modifier(Modifier::BOLD)
+    };
+    let inactive_bg = theme.surface0.bg;
+    let with_pill_bg = |base: Style| -> Style {
+        if state.basic_terminal {
+            base
+        } else if let Some(bg) = inactive_bg {
+            base.bg(bg)
+        } else {
+            base
+        }
+    };
+
+    raw_pills.push(RawPill {
+        filter: None,
+        label: all_label,
+        is_active: all_active,
+        style: if all_active {
+            active_style
+        } else if modal_active {
+            theme.muted
+        } else {
+            with_pill_bg(theme.subtext1)
+        },
+    });
+
+    for tab in tabs {
+        let is_active = state
+            .addon_stream_filter
+            .as_deref()
+            .is_some_and(|cur| cur.eq_ignore_ascii_case(&tab.name));
+        let label = match &tab.state {
+            AddonStreamState::Loading => {
+                if state.basic_terminal {
+                    format!(" {} ... ", tab.name)
+                } else {
+                    format!(" {} … ", tab.name)
+                }
+            }
+            AddonStreamState::Found(n) => format!(" {} ({n}) ", tab.name),
+            AddonStreamState::Empty | AddonStreamState::Blocked => format!(" {} (0) ", tab.name),
+            AddonStreamState::Failed(_) => format!(" {} (!) ", tab.name),
+        };
+        let style = if is_active {
+            active_style
+        } else if modal_active {
+            theme.muted
+        } else {
+            match &tab.state {
+                AddonStreamState::Loading => with_pill_bg(theme.lavender),
+                AddonStreamState::Found(_) => with_pill_bg(theme.success),
+                AddonStreamState::Empty => with_pill_bg(theme.text_dim),
+                AddonStreamState::Blocked => with_pill_bg(theme.rating),
+                AddonStreamState::Failed(_) => with_pill_bg(theme.error),
+            }
+        };
+        raw_pills.push(RawPill {
+            filter: Some(tab.name),
+            label,
+            is_active,
+            style,
+        });
+    }
+
+    let active_idx = raw_pills.iter().position(|p| p.is_active).unwrap_or(0);
+    let max_width = bar_area.width as usize;
+
+    let mut start = 0usize;
+    loop {
+        let left_reserve = if start > 0 { 2 } else { 0 };
+        let mut used = left_reserve;
+        let mut active_fits = false;
+        for (idx, pill) in raw_pills.iter().enumerate().skip(start) {
+            let pw = crate::tui::text::width(&pill.label);
+            let gap = if idx > start { 1 } else { 0 };
+            let right_reserve = if idx + 1 < raw_pills.len() { 2 } else { 0 };
+            if used + gap + pw + right_reserve <= max_width || idx == start {
+                used += gap + pw;
+                if idx == active_idx {
+                    active_fits = true;
+                }
+            } else {
+                break;
+            }
+        }
+        if active_fits || start >= active_idx {
+            break;
+        }
+        start += 1;
+    }
+
+    let mut spans: Vec<Span<'static>> = Vec::new();
+    let mut hit_rects: Vec<AddonFilterPill> = Vec::new();
+    let mut cursor_x = bar_area.x;
+    let bar_end_x = bar_area.x.saturating_add(bar_area.width);
+
+    if start > 0 {
+        let arrow = if state.basic_terminal { "< " } else { "‹ " };
+        let arrow_w = crate::tui::text::width(arrow) as u16;
+        spans.push(Span::styled(arrow, if modal_active { theme.muted } else { theme.text_dim }));
+        cursor_x = cursor_x.saturating_add(arrow_w);
+    }
+
+    let mut truncated_right = false;
+    for (idx, pill) in raw_pills.into_iter().enumerate().skip(start) {
+        let gap_w: u16 = if idx > start { 1 } else { 0 };
+        let pill_w = crate::tui::text::width(&pill.label) as u16;
+        let needed = cursor_x.saturating_add(gap_w).saturating_add(pill_w);
+        if needed > bar_end_x {
+            if idx == start {
+                let avail = bar_end_x.saturating_sub(cursor_x) as usize;
+                let truncated =
+                    crate::tui::text::truncate_width(&pill.label, avail).into_owned();
+                let tw = crate::tui::text::width(&truncated) as u16;
+                if tw > 0 {
+                    hit_rects.push(AddonFilterPill {
+                        filter: pill.filter,
+                        rect: Rect::new(cursor_x, bar_area.y, tw, 1),
+                    });
+                    spans.push(Span::styled(truncated, pill.style));
+                }
+            } else {
+                truncated_right = true;
+            }
