+/// 3 = unknown seeder count, 2 = bad torrent (1-4 seeds),
+/// 1 = bad torrent (0 seeds), 0 = CAM/telesync-type rip (listed last overall).
+fn source_tier(url: &str, seeders: Option<u32>, filename: &str) -> u8 {
