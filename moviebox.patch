+    /// Addon tabs for the Streams filter bar, busiest first: addons with the
+    /// most streams lead, then addons still loading, then empty, blocked and
+    /// failed ones. Recomputed on every draw, so the order follows the live
+    /// counts as slower addons answer. Equal counts keep the install order.
+    pub fn addon_filter_tabs(&self) -> Vec<crate::providers::addons::AddonStreamStatus> {
+        use crate::providers::addons::AddonStreamState;
+
+        let mut tabs = self.addon_filter_tabs_unsorted();
+        tabs.sort_by_key(|tab| match &tab.state {
+            AddonStreamState::Found(n) => (0u8, std::cmp::Reverse(*n)),
+            AddonStreamState::Loading => (1, std::cmp::Reverse(0)),
+            AddonStreamState::Empty => (2, std::cmp::Reverse(0)),
+            AddonStreamState::Blocked => (3, std::cmp::Reverse(0)),
+            AddonStreamState::Failed(_) => (4, std::cmp::Reverse(0)),
+        });
+        tabs
+    }
+
+    fn addon_filter_tabs_unsorted(&self) -> Vec<crate::providers::addons::AddonStreamStatus> {
+        if !self.addon_stream_statuses.is_empty() {
+            return self.addon_stream_statuses.clone();
+        }
+        if self.current_subject_provider() != ProviderKind::Addons || self.selected_resources.is_empty() {
+            return Vec::new();
+        }
+        let mut names: Vec<String> = Vec::new();
+        for rel in &self.selected_resources {
+            for mirror in &rel.mirrors {
+                let raw = crate::providers::addons::extract_addon_name_from_label(&mirror.label);
+                if !raw.is_empty() && !names.iter().any(|n| n.eq_ignore_ascii_case(raw)) {
+                    names.push(raw.to_string());
+                }
+            }
+        }
+        names
+            .into_iter()
+            .map(|name| {
+                let count = self
+                    .selected_resources
+                    .iter()
+                    .filter(|r| crate::providers::addons::release_matches_addon(r, &name))
+                    .count();
+                crate::providers::addons::AddonStreamStatus {
+                    name,
+                    state: if count > 0 {
+                        crate::providers::addons::AddonStreamState::Found(count)
+                    } else {
+                        crate::providers::addons::AddonStreamState::Empty
+                    },
+                }
+            })
+            .collect()
+    }
+
+    pub fn visible_resources(&self) -> Vec<&Release> {
+        match &self.addon_stream_filter {
+            Some(addon_name) => self
+                .selected_resources
+                .iter()
+                .filter(|r| crate::providers::addons::release_matches_addon(r, addon_name))
+                .collect(),
+            None => self.selected_resources.iter().collect(),
+        }
+    }
+
+    pub fn set_addon_filter(&mut self, filter: Option<String>) {
+        self.addon_stream_filter = filter;
+        let visible_len = self.visible_resources().len();
+        self.resource_list_state
+            .select(if visible_len == 0 { None } else { Some(0) });
+    }
+
+    pub fn cycle_addon_filter(&mut self, forward: bool) {
+        let tabs = self.addon_filter_tabs();
+        if tabs.is_empty() {
+            return;
+        }
+        let mut options: Vec<Option<String>> = Vec::with_capacity(tabs.len() + 1);
+        options.push(None);
+        for tab in tabs {
+            options.push(Some(tab.name));
+        }
+        let current_idx = self
+            .addon_stream_filter
+            .as_deref()
+            .and_then(|cur| {
+                options.iter().position(|opt| {
+                    opt.as_deref()
+                        .is_some_and(|name| name.eq_ignore_ascii_case(cur))
+                })
+            })
+            .unwrap_or(0);
+        let next_idx = if forward {
+            (current_idx + 1) % options.len()
+        } else {
+            (current_idx + options.len() - 1) % options.len()
+        };
+        self.set_addon_filter(options[next_idx].clone());
+    }
