+        }
+        hit_rects.push(AddonFilterPill {
+            filter: pill.filter,
+            rect: Rect::new(cursor_x, bar_area.y, pill_w, 1),
+        });
+        spans.push(Span::styled(pill.label, pill.style));
+        cursor_x = cursor_x.saturating_add(pill_w);
+    }
+
+    if truncated_right && cursor_x < bar_end_x {
+        let arrow = if state.basic_terminal { " >" } else { " ›" };
+        if cursor_x.saturating_add(2) <= bar_end_x {
+            spans.push(Span::styled(arrow, if modal_active { theme.muted } else { theme.text_dim }));
+        }
+    }
+
+    (hit_rects, Line::from(spans))
+}
